  printf "LBDCF  %x\n", (($value >> 8) & 1)
  printf "TCBGTC %x\n", (($value >> 7) & 1)
  printf "TCCF   %x\n", (($value >> 6) & 1)
  printf "TXFECF %x\n", (($value >> 5) & 1)
  printf "IDLECF %x\n", (($value >> 4) & 1)
  printf "ORECF  %x\n", (($value >> 3) & 1)
  printf "NCF    %x\n", (($value >> 2) & 1)
  printf "FECF   %x\n", (($value >> 1) & 1)
  printf "PECF   %x\n", (($value >> 0) & 1)
end

