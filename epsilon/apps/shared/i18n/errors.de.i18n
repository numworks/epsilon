EmptyMatrixNotHandled = "Syntaxfehler:\nLeere Matrizen werden nicht\nunterstützt."
EmptyVectorsNotHandled = "Syntaxfehler:\nLeere Vektoren werden nicht\nunterstützt."
ExponentTooBig = "Syntaxfehler:\nDer Exponent ist zu groß."
ForbiddenImplicitMultiplication = "Syntaxfehler:\nImplizite Multiplikation verboten.\nVerwenden Sie die\nMultiplikationstaste mit\nHexadezimal- oder Binärwerten."
FunctionAndVariableMustHaveDistinctNames = "Syntaxfehler:\nFunktion und Variable müssen\neindeutige Namen haben."
FunctionMustHave1Or2Parameters = "Syntaxfehler:\nElemente einer Liste können\neinzeln oder als Ausschnitt\naufgerufen werden."
FunctionMustHaveOnly1Parameter = "Syntaxfehler:\nVerwenden Sie {}, um eine Funktion\nfür eine Werteliste auszuwerten."
InvalidMatrixDimension = "Syntaxfehler:\nUngültige Matrixdimension."
EmptyParentheses = "Syntaxfehler:\nLeere Klammern werden nicht\nunterstützt."
MissingParameterOnTheLeft = "Syntaxfehler:\nFehlender Wert vor dem Zeichen."
MissingParentheses = "Syntaxfehler:\nFehlende Klammern."
MissingParenthesisInFunctionExponent = "Syntaxfehler:\nFehlende Klammer im Exponenten."
MissingRightBracket = "Syntaxfehler:\nFehlende rechte eckige Klammer."
MissingRightParenthesis = "Syntaxfehler:\nFehlende rechte Klammer."
MissingSequenceIndex = "Syntaxfehler:\nFehlender Folgenindex."
RightSideMustBeSymbolOrFunction = "Syntaxfehler:\nDie rechte Seite muss ein Symbol\noder eine Funktion sein."
ThisFunctionCantBePowered = "Syntaxfehler:\nSetzen Sie den Exponenten nach der\nrechten Klammer."
ThisFunctionHasNoInverse = "Syntaxfehler:\nDiese Funktion hat keine\nUmkehrfunktion."
VariableNameTooLong = "Syntaxfehler:\nDer Variablenname ist zu lang."
ParametricMustDependOnVariable = "Syntaxfehler:\nDie Berechnung muss von einer\nVariablen abhängen."
IncompleteExpression = "Syntaxfehler:\nUnvollständiger Ausdruck."
CannotParsePercentOperator = "Syntaxfehler:\nProzentuales Erhöhen und\nVerringern muss das Prozentzeichen\nenthalten."
NoBooleansBeforeNot = "Syntaxfehler:\nKeine Booleschen Werte vor not."
Only2DPointsHandled = "Syntaxfehler:\nNur 2D-Punkte werden unterstützt."
TooManyParameters = "Syntaxfehler:\nZu viele Parameter angegeben."
TooFewParameters = "Syntaxfehler:\nZu wenige Parameter angegeben."
NLLogBaseShouldBeLeftOfLog = "Syntaxfehler:\nLogarithmusbasis muss links vom\nLog stehen."
OnlyLogShouldUsePrefixLogBase = "Syntaxfehler:\nNur log kann ein Basispräfix\nhaben."
NonAcceptableExpression = "Syntaxfehler:\nFolgen müssen explizit definiert\nwerden. Verwenden Sie eine Vorlage\nfür eine rekursive Folge."
ExponentCannotExistAlone = "Syntaxfehler:\nEin Exponent kann nicht ohne eine\nBasis existieren."
