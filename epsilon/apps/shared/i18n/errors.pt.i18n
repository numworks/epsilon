EmptyMatrixNotHandled = "Erro de sintaxe:\nMatrizes vazias não são\nsuportadas."
EmptyVectorsNotHandled = "Erro de sintaxe:\nVetores vazios não são suportados."
ExponentTooBig = "Erro de sintaxe:\nO expoente é muito grande."
ForbiddenImplicitMultiplication = "Erro de sintaxe:\nMultiplicação implícita proibida.\nUse o botão de multiplicação com\nvalores hexadecimais ou binários."
FunctionAndVariableMustHaveDistinctNames = "Erro de sintaxe:\nFunção e variável devem ter nomes\ndistintos."
FunctionMustHave1Or2Parameters = "Erro de sintaxe:\nOs elementos de uma lista podem\nser indicados um de cada vez ou\nnum intervalo."
FunctionMustHaveOnly1Parameter = "Erro de sintaxe:\nUse {} para avaliar uma função\npara uma lista de valores."
InvalidMatrixDimension = "Erro de sintaxe:\nDimensão de matriz inválida."
EmptyParentheses = "Erro de sintaxe:\nParênteses vazios não são\nsuportados."
MissingParameterOnTheLeft = "Erro de sintaxe:\nValor ausente antes do carácter."
MissingParentheses = "Erro de sintaxe:\nParênteses ausentes."
MissingParenthesisInFunctionExponent = "Erro de sintaxe:\nParêntese ausente no expoente."
MissingRightBracket = "Erro de sintaxe:\nParêntese reto direito ausente."
MissingRightParenthesis = "Erro de sintaxe:\nParêntese direito ausente."
MissingSequenceIndex = "Erro de sintaxe:\nÍndice da sequência ausente."
RightSideMustBeSymbolOrFunction = "Erro de sintaxe:\nO elemento do lado direito deve\nser um símbolo ou função."
ThisFunctionCantBePowered = "Erro de sintaxe:\nColoque o expoente após o\nparêntese direito."
ThisFunctionHasNoInverse = "Erro de sintaxe:\nEsta função não tem função\ninversa."
VariableNameTooLong = "Erro de sintaxe:\nO nome da variável é muito longo."
ParametricMustDependOnVariable = "Erro de sintaxe:\nO cálculo deve depender de uma\nvariável."
IncompleteExpression = "Erro de sintaxe:\nExpressão incompleta."
CannotParsePercentOperator = "Erro de sintaxe:\nO aumento e a diminuição\npercentuais devem incluir o\nsímbolo de percentagem."
NoBooleansBeforeNot = "Erro de sintaxe:\nSem booleanos antes de not."
Only2DPointsHandled = "Erro de sintaxe:\nApenas pontos 2D são suportados."
TooManyParameters = "Erro de sintaxe:\nForam fornecidos parâmetros em\nexcesso."
TooFewParameters = "Erro de sintaxe:\nNão foram fornecidos parâmetros\nsuficientes."
NLLogBaseShouldBeLeftOfLog = "Erro de sintaxe:\nA base do logaritmo deve estar à\nesquerda do log."
OnlyLogShouldUsePrefixLogBase = "Erro de sintaxe:\nApenas o log pode ter um prefixo\nde base."
NonAcceptableExpression = "Erro de sintaxe:\nAs sequências devem ser definidas\nexplicitamente. Use um modelo para\numa sequência recursiva."
ExponentCannotExistAlone = "Erro de sintaxe:\nUm expoente não pode existir sem\numa base."
