EmptyMatrixNotHandled = "Syntaxisfout:\nLege matrices worden niet\nondersteund."
EmptyVectorsNotHandled = "Syntaxisfout:\nLege vectoren worden niet\nondersteund."
ExponentTooBig = "Syntaxisfout:\nDe exponent is te groot."
ForbiddenImplicitMultiplication = "Syntaxisfout:\nImpliciete vermenigvuldiging\nverboden. Gebruik de\nvermenigvuldigknop met\nhexadecimale of binaire waarden."
FunctionAndVariableMustHaveDistinctNames = "Syntaxisfout:\nFunctie en variabele moeten unieke\nnamen hebben."
FunctionMustHave1Or2Parameters = "Syntaxisfout:\nElementen van een lijst kunnen één\nvoor één of als een segment worden\nopgeroepen."
FunctionMustHaveOnly1Parameter = "Syntaxisfout:\nGebruik {} om een functie te\nevalueren voor een lijst met\nwaarden."
InvalidMatrixDimension = "Syntaxisfout:\nOngeldige matrixdimensie."
EmptyParentheses = "Syntaxisfout:\nLege haakjes worden niet\nondersteund."
MissingParameterOnTheLeft = "Syntaxisfout:\nOntbrekende waarde vóór karakter."
MissingParentheses = "Syntaxisfout:\nOntbrekende haakjes."
MissingParenthesisInFunctionExponent = "Syntaxisfout:\nOntbrekend haakje in de exponent."
MissingRightBracket = "Syntaxisfout:\nOntbrekend rechter rechte haakje."
MissingRightParenthesis = "Syntaxisfout:\nOntbrekend rechter haakje."
MissingSequenceIndex = "Syntaxisfout:\nOntbrekende reeksindex."
RightSideMustBeSymbolOrFunction = "Syntaxisfout:\nRechterkant moet een symbool of\nfunctie zijn."
ThisFunctionCantBePowered = "Syntaxisfout:\nPlaats de exponent na het rechter\nhaakje."
ThisFunctionHasNoInverse = "Syntaxisfout:\nDeze functie heeft geen inverse."
VariableNameTooLong = "Syntaxisfout:\nVariabelenaam is te lang."
ParametricMustDependOnVariable = "Syntaxisfout:\nBerekening moet afhankelijk zijn\nvan een variabele."
IncompleteExpression = "Syntaxisfout:\nOnvolledige expressie."
CannotParsePercentOperator = "Syntaxisfout:\nProcentuele toe- en afname moeten\nhet procentteken bevatten."
NoBooleansBeforeNot = "Syntaxisfout:\nGeen booleaanse waarden vóór not."
Only2DPointsHandled = "Syntaxisfout:\nAlleen 2D-punten worden\nondersteund."
TooManyParameters = "Syntaxisfout:\nTe veel parameters opgegeven."
TooFewParameters = "Syntaxisfout:\nTe weinig parameters opgegeven."
NLLogBaseShouldBeLeftOfLog = "Syntaxisfout:\nLogbasis moet links van de log\nstaan."
OnlyLogShouldUsePrefixLogBase = "Syntaxisfout:\nAlleen log kan een basisprefix\nhebben."
NonAcceptableExpression = "Syntaxisfout:\nHet invoerformaat is ongeldig."
ExponentCannotExistAlone = "Syntaxisfout:\nEen exponent kan niet zonder een\ngrondtal bestaan."
