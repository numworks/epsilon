EmptyMatrixNotHandled = "Sintassi errata:\nLe matrici vuote non sono gestite."
EmptyVectorsNotHandled = "Sintassi errata:\nI vettori vuoti non sono gestiti."
ExponentTooBig = "Sintassi errata:\nL'esponente è troppo grande."
ForbiddenImplicitMultiplication = "Sintassi errata:\nMoltiplicazione implicita vietata.\nUsa il pulsante di moltiplicazione\ncon valori esadecimali o binari."
FunctionAndVariableMustHaveDistinctNames = "Sintassi errata:\nFunzione e variabile devono avere\nnomi distinti."
FunctionMustHave1Or2Parameters = "Sintassi errata:\nGli elementi di una lista possono\nessere chiamati uno alla volta o\ncome una sezione."
FunctionMustHaveOnly1Parameter = "Sintassi errata:\nUsa {} per valutare una funzione\nper un elenco di valori."
InvalidMatrixDimension = "Sintassi errata:\nDimensione della matrice non\nvalida."
EmptyParentheses = "Sintassi errata:\nLe parentesi vuote non sono\ngestite."
MissingParameterOnTheLeft = "Sintassi errata:\nValore mancante prima del\ncarattere."
MissingParentheses = "Sintassi errata:\nParentesi mancanti."
MissingParenthesisInFunctionExponent = "Sintassi errata:\nParentesi mancante nell'esponente."
MissingRightBracket = "Sintassi errata:\nParentesi quadra destra mancante."
MissingRightParenthesis = "Sintassi errata:\nParentesi destra mancante."
MissingSequenceIndex = "Sintassi errata:\nIndice di sequenza mancante."
RightSideMustBeSymbolOrFunction = "Sintassi errata:\nIl lato destro deve essere un\nsimbolo o una funzione."
ThisFunctionCantBePowered = "Sintassi errata:\nPosiziona l'esponente dopo la\nparentesi destra."
ThisFunctionHasNoInverse = "Sintassi errata:\nQuesta funzione non ha un inverso."
VariableNameTooLong = "Sintassi errata:\nIl nome della variabile è troppo\nlungo."
ParametricMustDependOnVariable = "Sintassi errata:\nIl calcolo deve dipendere da una\nvariabile."
IncompleteExpression = "Sintassi errata:\nEspressione incompleta."
CannotParsePercentOperator = "Sintassi errata:\nL'aumento e la diminuzione\npercentuale devono includere il\nsegno di percentuale."
NoBooleansBeforeNot = "Sintassi errata:\nNessun booleano prima di not."
Only2DPointsHandled = "Sintassi errata:\nSolo i punti 2D sono gestiti."
TooManyParameters = "Sintassi errata:\nTroppi parametri forniti."
TooFewParameters = "Sintassi errata:\nTroppo pochi parametri forniti."
NLLogBaseShouldBeLeftOfLog = "Sintassi errata:\nLa base del logaritmo deve essere\na sinistra del log."
OnlyLogShouldUsePrefixLogBase = "Sintassi errata:\nSolo il log può avere un prefisso\ndi base."
NonAcceptableExpression = "Sintassi errata:\nIl formato di input non è valido."
ExponentCannotExistAlone = "Sintassi errata:\nUn esponente non può esistere\nsenza una base."
