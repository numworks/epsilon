EmptyMatrixNotHandled = "Syntax error:\nEmpty matrices are not handled."
EmptyVectorsNotHandled = "Syntax error:\nEmpty vectors are not handled."
ExponentTooBig = "Syntax error:\nExponent is too large."
ForbiddenImplicitMultiplication = "Syntax error:\nForbidden implicit multiplication.\nUse the multiplication button with\nhexadecimal or binary values."
FunctionAndVariableMustHaveDistinctNames = "Syntax error:\nFunction and variable must have\nunique names."
FunctionMustHave1Or2Parameters = "Syntax error:\nElements of a list can be called\none at a time or as a slice."
FunctionMustHaveOnly1Parameter = "Syntax error:\nUse {} to evaluate a function for\na list of values."
InvalidMatrixDimension = "Syntax error:\nInvalid matrix dimension."
EmptyParentheses = "Syntax error:\nEmpty parentheses are not handled."
MissingParameterOnTheLeft = "Syntax error:\nMissing value before character."
MissingParentheses = "Syntax error:\nMissing parentheses."
MissingParenthesisInFunctionExponent = "Syntax error:\nMissing parenthesis in exponent."
MissingRightBracket = "Syntax error:\nMissing right bracket."
MissingRightParenthesis = "Syntax error:\nMissing right parenthesis."
MissingSequenceIndex = "Syntax error:\nMissing sequence index."
RightSideMustBeSymbolOrFunction = "Syntax error:\nRight side must be a symbol or\nfunction."
ThisFunctionCantBePowered = "Syntax error:\nPlace exponent after right\nparenthesis."
ThisFunctionHasNoInverse = "Syntax error:\nThis function has no inverse."
VariableNameTooLong = "Syntax error:\nVariable name is too long."
ParametricMustDependOnVariable = "Syntax error:\nCalculation must depend on a\nvariable."
IncompleteExpression = "Syntax error:\nIncomplete expression."
CannotParsePercentOperator = "Syntax error:\nPercent increase and decrease must\ninclude the percent sign."
NoBooleansBeforeNot = "Syntax error:\nNo booleans before not."
Only2DPointsHandled = "Syntax error:\nOnly 2D points are handled."
TooManyParameters = "Syntax error:\nToo many parameters provided."
TooFewParameters = "Syntax error:\nToo few parameters provided."
NLLogBaseShouldBeLeftOfLog = "Syntax error:\nLog base should be left of log."
OnlyLogShouldUsePrefixLogBase = "Syntax error:\nOnly log can have a base prefix."
NonAcceptableExpression = "Syntax error:\nSequences must be defined\nexplicitly. Use a template for a\nrecursive sequence."
ExponentCannotExistAlone = "Syntax error:\nAn exponent cannot exist without a\nbase."
