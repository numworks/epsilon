EmptyMatrixNotHandled = "Error sintáctico:\nLas matrices vacías no son\ncompatibles."
EmptyVectorsNotHandled = "Error sintáctico:\nLos vectores vacíos no son\ncompatibles."
ExponentTooBig = "Error sintáctico:\nEl exponente es demasiado grande."
ForbiddenImplicitMultiplication = "Error sintáctico:\nMultiplicación implícita no\npermitida. Use el botón de\nmultiplicación con valores\nhexadecimales o binarios."
FunctionAndVariableMustHaveDistinctNames = "Error sintáctico:\nLa función y la variable deben\ntener nombres distintos."
FunctionMustHave1Or2Parameters = "Error sintáctico:\nLos elementos de una lista pueden\nllamarse de uno en uno o como un\nsegmento."
FunctionMustHaveOnly1Parameter = "Error sintáctico:\nUse {} para evaluar una función\npara una lista de valores."
InvalidMatrixDimension = "Error sintáctico:\nDimensión de matriz no válida."
EmptyParentheses = "Error sintáctico:\nLos paréntesis vacíos no son\ncompatibles."
MissingParameterOnTheLeft = "Error sintáctico:\nFalta un valor antes del carácter."
MissingParentheses = "Error sintáctico:\nFaltan paréntesis."
MissingParenthesisInFunctionExponent = "Error sintáctico:\nFalta un paréntesis en el\nexponente."
MissingRightBracket = "Error sintáctico:\nFalta el corchete derecho."
MissingRightParenthesis = "Error sintáctico:\nFalta el paréntesis derecho."
MissingSequenceIndex = "Error sintáctico:\nFalta el índice de la sucesión."
RightSideMustBeSymbolOrFunction = "Error sintáctico:\nEl lado derecho debe ser un\nsímbolo o función."
ThisFunctionCantBePowered = "Error sintáctico:\nColoque el exponente después del\nparéntesis derecho."
ThisFunctionHasNoInverse = "Error sintáctico:\nEsta función no tiene inversa."
VariableNameTooLong = "Error sintáctico:\nEl nombre de la variable es\ndemasiado largo."
ParametricMustDependOnVariable = "Error sintáctico:\nEl cálculo debe depender de una\nvariable."
IncompleteExpression = "Error sintáctico:\nExpresión incompleta."
CannotParsePercentOperator = "Error sintáctico:\nEl aumento y la disminución\nporcentual deben incluir el signo\nde porcentaje."
NoBooleansBeforeNot = "Error sintáctico:\nNo hay booleanos antes de not."
Only2DPointsHandled = "Error sintáctico:\nSolo se admiten puntos 2D."
TooManyParameters = "Error sintáctico:\nSe han proporcionado demasiados\nparámetros."
TooFewParameters = "Error sintáctico:\nSe han proporcionado muy pocos\nparámetros."
NLLogBaseShouldBeLeftOfLog = "Error sintáctico:\nLa base del logaritmo debe estar a\nla izquierda del log."
OnlyLogShouldUsePrefixLogBase = "Error sintáctico:\nSolo el log puede tener un prefijo\nde base."
NonAcceptableExpression = "Error sintáctico:\nLas sucesiones deben definirse\nexplícitamente. Use una plantilla\npara una sucesión recursiva."
ExponentCannotExistAlone = "Error sintáctico:\nUn exponente no puede existir sin\nuna base."
