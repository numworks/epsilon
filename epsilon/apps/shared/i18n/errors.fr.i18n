EmptyMatrixNotHandled = "Attention à la syntaxe :\nLes matrices vides ne sont pas\ngérées."
EmptyVectorsNotHandled = "Attention à la syntaxe :\nLes vecteurs vides ne sont pas\ngérés."
ExponentTooBig = "Attention à la syntaxe :\nL'exposant est trop grand."
