end
define showUSBPHYC_TUNE
  set $value = *(uint32_t *)0x40017c0c
  printf "INCURREN      %x\n", (($value >> 0) & 1)
  printf "INCURRINT     %x\n", (($value >> 1) & 1)
  printf "LFSCAPEN      %x\n", (($value >> 2) & 1)
  printf "HSDRVSLEW     %x\n", (($value >> 3) & 1)
  printf "HSDRVDCCUR    %x\n", (($value >> 4) & 1)
  printf "HSDRVDCLEV    %x\n", (($value >> 5) & 1)
  printf "HSDRVCURINCR  %x\n", (($value >> 6) & 1)
  printf "FSDRVRFADJ    %x\n", (($value >> 7) & 1)
  printf "HSDRVRFRED    %x\n", (($value >> 8) & 1)
  printf "HSDRVCHKITRM  %x\n", (($value >> 9) & 15)
  printf "HSDRVCHKZTRM  %x\n", (($value >> 13) & 3)
  printf "SQLCHCTL      %x\n", (($value >> 15) & 3)
  printf "HDRXGNEQEN    %x\n", (($value >> 17) & 1)
  printf "STAGSEL       %x\n", (($value >> 18) & 1)
  printf "HSFALLPREEM   %x\n", (($value >> 19) & 1)
  printf "HSRXOFF       %x\n", (($value >> 20) & 3)
  printf "SHTCCTCTLPROT %x\n", (($value >> 22) & 1)
  printf "SQLBYP        %x\n", (($value >> 23) & 1)
end

