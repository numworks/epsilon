FunctionAndVariableMustHaveDistinctNames = "Attention à la syntaxe :\nLa fonction et la variable doivent\navoir des noms distincts."
FunctionMustHave1Or2Parameters = "Attention à la syntaxe :\nLes éléments d'une liste peuvent\nêtre appelés un par un ou sous\nforme de tranche."
FunctionMustHaveOnly1Parameter = "Attention à la syntaxe :\nUtilisez {} pour évaluer une\nfonction sur une liste de valeurs."
InvalidMatrixDimension = "Attention à la syntaxe :\nDimension de matrice invalide."
EmptyParentheses = "Attention à la syntaxe :\nLes parenthèses vides ne sont pas\ngérées."
MissingParameterOnTheLeft = "Attention à la syntaxe :\nValeur manquante avant le\ncaractère."
MissingParentheses = "Attention à la syntaxe :\nParenthèses manquantes."
MissingParenthesisInFunctionExponent = "Attention à la syntaxe :\nParenthèse manquante dans\nl'exposant."
MissingRightBracket = "Attention à la syntaxe :\nCrochet droit manquant."
MissingRightParenthesis = "Attention à la syntaxe :\nParenthèse droite manquante."
MissingSequenceIndex = "Attention à la syntaxe :\nIndice de suite manquant."
RightSideMustBeSymbolOrFunction = "Attention à la syntaxe :\nLe membre droit doit être un\nsymbole ou une fonction."
ThisFunctionCantBePowered = "Attention à la syntaxe :\nPlacez l'exposant après la\nparenthèse droite."
ThisFunctionHasNoInverse = "Attention à la syntaxe :\nCette fonction n'a pas d'inverse."
VariableNameTooLong = "Attention à la syntaxe :\nLe nom de la variable est trop\nlong."
ParametricMustDependOnVariable = "Attention à la syntaxe :\nLe calcul doit dépendre d'une\nvariable."
IncompleteExpression = "Attention à la syntaxe :\nExpression incomplète."
CannotParsePercentOperator = "Attention à la syntaxe :\nL'augmentation et la diminution en\npourcentage doivent inclure le\nsigne pourcentage."
NoBooleansBeforeNot = "Attention à la syntaxe :\nPas de booléen avant not."
Only2DPointsHandled = "Attention à la syntaxe :\nSeuls les points 2D sont gérés."
TooManyParameters = "Attention à la syntaxe :\nTrop de paramètres fournis."
TooFewParameters = "Attention à la syntaxe :\nPas assez de paramètres fournis."
NLLogBaseShouldBeLeftOfLog = "Attention à la syntaxe :\nLa base du logarithme doit être à\ngauche du log."
OnlyLogShouldUsePrefixLogBase = "Attention à la syntaxe :\nSeul le log peut avoir un préfixe\nde base."
NonAcceptableExpression = "Attention à la syntaxe :\nLe format de saisie est invalide."
ExponentCannotExistAlone = "Attention à la syntaxe :\nUn exposant ne peut pas exister\nsans base."
